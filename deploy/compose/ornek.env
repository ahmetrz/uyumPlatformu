# Kopyalayın: cp ornek.env .env   ·   `.env` DEPOYA GİRMEZ (.gitignore)
# Boş bırakılan ZORUNLU satır kuruluma HATA verdirir; sessiz varsayılan
# yoktur. Zorunlu olmayan satırlar (aşağıda işaretli) boş bırakılabilir ve
# şemadaki YAZILI varsayılana düşer — o da bir karardır, sessizlik değil.

# ── veritabanı ────────────────────────────────────────────────────────
PG_VERITABANI=uyum
PG_KULLANICI=uyum
# Üretin — URL-GÜVENLİ olmalı:
#   openssl rand -hex 32
# `openssl rand -base64 32` KULLANMAYIN. Parola bağlantı dizesine
# (`postgresql://kullanici:PAROLA@…`) kaçışsız gömülür ve base64 çıktısında
# geçebilen `/` URI otoritesini BÖLER. (`+` ve `=` bölmez — ölçüldü; kusuru
# üreten karakter yalnız `/`.) 43 karakterlik çıktıda en az bir `/` görme
# olasılığı ~%49. Kusur OPAKTIR: PostgreSQL parolayı kabul eder, yalnız
# uygulama bağlanamaz. Kurulum bunu açılışta ADIYLA yakalar.
PG_PAROLA=

# ── kurulum kimliği ───────────────────────────────────────────────────
# Kurulumun adı (ekranda kabuk sözcük markasının ilk satırı).
KIRACI_AD=
# Ürün adını ezmek isterseniz; boş bırakılırsa web/lib/marka.ts kazanır.
MARKA_AD=

# ── ağ ────────────────────────────────────────────────────────────────
UYGULAMA_PORTU=3000
# Ters vekil arkasındaysanız kaç vekil atlanacak (web/lib/istemciAdresi.ts).
TRUST_PROXY=

# ── oran sınırları (boş = şemadaki yazılı varsayılan) ──────────────────
API_ORAN_SINIRI=
GIRIS_ORAN_SINIRI=
