// Uyum Platformu veri şeması — docs/ICERIK_MODELI.md'yi birebir izler.
//
// Temel ilke (kullanıcı kararı): hiçbir tanım koda gömülü değildir.
// Sektörler, tesis tipleri (doğalgaz, jeotermal, HES, RES...), tesisler,
// regülasyonlar, kapsam alanları (BT/OT...) ve uyum süreçleri (denetimler)
// panelden tanımlanır, eşleştirilir ve yaşam döngüsü yönetilir
// (santral kapanır/satılır, süreç pasifleşir, kapsam değişir).
//
// Sağlayıcı SQLite (kurulumsuz); Postgres'e geçişte yalnızca datasource değişir.
// Enum kullanılmaz: değerler String + web/lib/sabitler.ts'te zod ile doğrulanır.

generator client {
  provider = "prisma-client"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "sqlite"
}

// ------------------------------------------------------- tanımlar (panelden)

model Sektor {
  id    String  @id @default(cuid())
  kod   String  @unique // ELEKTRIK-URETIM ...
  ad    String
  aktif Boolean @default(true)

  tipler TesisTipi[]
}

model TesisTipi {
  id       String  @id @default(cuid())
  kod      String  @unique // DGKC | JEO | HES | RES | GES | TERMIK | MERKEZ ...
  ad       String
  sektorId String?
  sira     Int     @default(0)
  aktif    Boolean @default(true)

  sektor   Sektor? @relation(fields: [sektorId], references: [id])
  tesisler Tesis[]
}

/// Santral / lokasyon. Yaşam döngüsü: aktif → kapali (satış, kapanış).
model Tesis {
  id            String    @id @default(cuid())
  kod           String    @unique
  ad            String
  tipId         String?
  kuruluGucMw   Float?
  konum         String?
  durum         String    @default("aktif") // aktif | kapali
  devreyeGiris  DateTime?
  kapanisTarihi DateTime?
  kapanisNedeni String? // satis | kapanis | birlesme ...
  olusturuldu   DateTime  @default(now())

  /// Santral fotoğrafının anahtarı (05-photography §5): eşleme bileşen
  /// kodunda değil VERİDE tutulur ki yeni bir santral yanlış varsayılanı
  /// miras almasın. null ise tipografik fallback render edilir — asla
  /// "yakın" bir başka santralin fotoğrafı kullanılmaz.
  gorselAnahtari String?

  tuzelKisiId String?

  tip       TesisTipi? @relation(fields: [tipId], references: [id])
  tuzelKisi TuzelKisi? @relation(fields: [tuzelKisiId], references: [id])

  surecKapsamlari SurecKapsami[]
  maddeDurumlari  MaddeDurumu[]
  yetkiler        Yetki[]

  // hedef mimari genişlemesi
  profil                    TesisProfili?
  uniteler                  UretimUnitesi[]
  sistemler                 SistemServis[]
  isSurecleri               IsSureci[]
  uygulanabilirlikKararlari UygulanabilirlikKarari[]
  istisnalar                Istisna[]
  anlikler                  UyumAnlik[]
  riskler                   Risk[]
  denetimKapsamlari         DenetimKapsami[]
  varliklar                 Varlik[]
  agBolgeleri               AgBolgesi[]
  kimlikHesaplari           KimlikHesabi[]
  degisiklikler             Degisiklik[]
  olaylar                   Olay[]
  projeAdaylari             ProjeAdayi[]
  kanitBaglantilari         KanitTesis[]
  gorevler                  Gorev[]
  projeBaglantilari         ProjeBaglantisi[]
  topolojiAnliklari         TopolojiAnlik[]
  erisimOturumlari          TedarikciErisimOturumu[]
  kesifKayitlari            KesifKaydi[]
}

model Regulasyon {
  id            String    @id @default(cuid())
  kod           String    @unique // EPDK-SYM, CBDDO, ISO-27001, SPK-BS ... (panelden eklenir)
  ad            String
  surum         String?
  yururlukTarih DateTime?
  kaynakUrl     String?
  aktif         Boolean   @default(true)

  maddeler      Madde[]
  surecler      UyumSureci[]
  iceAktarimlar IceAktarim[]

  // hedef mimari genişlemesi
  surumler FrameworkSurumu[]
  kurallar UygulanabilirlikKurali[]
  kararlar UygulanabilirlikKarari[]
}

/// Kapsam alanı (BT, OT ...). Panelden tanımlanır; maddelerle çoktan-çoğa eşleştirilir.
model KapsamAlani {
  id       String  @id @default(cuid())
  kod      String  @unique
  ad       String
  aciklama String?
  aktif    Boolean @default(true)

  maddeAlanlari MaddeAlan[]
}

// ---------------------------------------------------------------- çekirdek

model Madde {
  id           String  @id @default(cuid())
  regulasyonId String
  ustMaddeId   String?
  kod          String // EPDK-SYM-4.2.1
  baslik       String
  metin        String
  kanitTipi    String?
  sira         Int     @default(0)

  // hedef mimari: kontrol source-of-truth (§4)
  surumId                String? // FrameworkSurumu — sürümsüz maddeler geçiş dönemi kaydıdır
  disKontrolId           String? // external_control_id
  alanAdi                String? // domain
  altAlan                String? // subdomain
  olgunlukSeviyesi       Int?
  zorunlulukTipi         String    @default("REGULATION") // LAW|REGULATION|REGULATOR_NOTIFICATION|CONTRACT|CORPORATE_POLICY|CERTIFICATION|BEST_PRACTICE|OPTIONAL
  gereksinimTipi         String?
  kaynakSayfa            String?
  maddeKaynakUrl         String?
  gecerliBaslangic       DateTime?
  gecerliBitis           DateTime?
  yeriniAlanId           String? // superseded_by
  kanitBeklentisi        String?
  degerlendirmeRehberi   String?
  varsayilanIncelemeGunu Int       @default(180)
  silindi                DateTime?

  regulasyon     Regulasyon       @relation(fields: [regulasyonId], references: [id], onDelete: Cascade)
  ustMadde       Madde?           @relation("MaddeHiyerarsi", fields: [ustMaddeId], references: [id])
  altMaddeler    Madde[]          @relation("MaddeHiyerarsi")
  surum          FrameworkSurumu? @relation(fields: [surumId], references: [id])
  yeriniAlan     Madde?           @relation("MaddeSuperseded", fields: [yeriniAlanId], references: [id])
  yerineGecenler Madde[]          @relation("MaddeSuperseded")

  alanlar           MaddeAlan[]
  durumlar          MaddeDurumu[]
  eslestirmeKaynak  MaddeEslestirmesi[] @relation("EslestirmeKaynak")
  eslestirmeHedef   MaddeEslestirmesi[] @relation("EslestirmeHedef")
  projeBaglantilari ProjeBaglantisi[]
  riskKontrolleri   RiskKontrol[]
  istisnalar        Istisna[]
  denetimKapsamlari DenetimKapsami[]

  @@unique([regulasyonId, surumId, kod])
}

/// Madde ↔ kapsam alanı eşleştirmesi (panelden yönetilir).
model MaddeAlan {
  id      String @id @default(cuid())
  maddeId String
  alanId  String

  madde Madde       @relation(fields: [maddeId], references: [id], onDelete: Cascade)
  alan  KapsamAlani @relation(fields: [alanId], references: [id], onDelete: Cascade)

  @@unique([maddeId, alanId])
}

/// Uyum süreci (denetim dönemi): bir regülasyonun belirli tesis kapsamında
/// yürütülen çalışması. Kapsam değişebilir; süreç pasifleşebilir/tamamlanır.
model UyumSureci {
  id           String    @id @default(cuid())
  kod          String    @unique // EPDK-SYM-2026 ...
  ad           String
  regulasyonId String
  durum        String    @default("planlandi") // planlandi | aktif | pasif | tamamlandi
  baslangic    DateTime?
  bitis        DateTime?
  aciklama     String?
  olusturuldu  DateTime  @default(now())

  regulasyon Regulasyon @relation(fields: [regulasyonId], references: [id], onDelete: Cascade)

  kapsam     SurecKapsami[]
  durumlar   MaddeDurumu[]
  yetkiler   Yetki[]
  anlikler   UyumAnlik[]
  denetimler Denetim[]
}

/// Süreç ↔ tesis kapsamı. Tesis kapsamdan çıkarılabilir (kayıt silinir),
/// geçmiş MaddeDurumu kayıtları tarihçe olarak kalır.
model SurecKapsami {
  id      String   @id @default(cuid())
  surecId String
  tesisId String
  eklendi DateTime @default(now())

  surec UyumSureci @relation(fields: [surecId], references: [id], onDelete: Cascade)
  tesis Tesis      @relation(fields: [tesisId], references: [id], onDelete: Cascade)

  @@unique([surecId, tesisId])
}

/// (Süreç × madde × tesis) kesişimi — sistemin en sık okunan tablosu.
model MaddeDurumu {
  id               String    @id @default(cuid())
  surecId          String
  maddeId          String
  tesisId          String
  durum            String    @default("degerlendirilmedi") // uyumlu | kismi | uyumsuz | degerlendirilmedi | incelemede | kapsamdisi
  guven            String    @default("kanit_yok") // otomatik_kanit | denetci_dogrulamis | oz_degerlendirme | bayat_kanit | kanit_yok
  kanitBayat       Boolean   @default(false)
  sorumluId        String?
  not              String?
  sonDegerlendirme DateTime?
  guncellendi      DateTime  @updatedAt

  surec   UyumSureci @relation(fields: [surecId], references: [id], onDelete: Cascade)
  madde   Madde      @relation(fields: [maddeId], references: [id], onDelete: Cascade)
  tesis   Tesis      @relation(fields: [tesisId], references: [id], onDelete: Cascade)
  sorumlu Kullanici? @relation("DurumSorumlusu", fields: [sorumluId], references: [id])

  bulgular          Bulgu[]
  kanitBaglantilari KanitBaglantisi[]
  tarihce           DegerlendirmeTarihcesi[]

  @@unique([surecId, maddeId, tesisId])
  @@index([surecId, tesisId, durum])
}

// ------------------------------------------------------------ bulgu/aksiyon

model Bulgu {
  id                  String    @id @default(cuid())
  maddeDurumuId       String
  denetimId           String?
  kokNeden            String?
  tekrarBulguId       String? // repeat_of — tekrar eden bulgu
  retestGerekli       Boolean   @default(false)
  retestSonucu        String?
  kapanisDogrulayanId String?
  kapanisDogrulama    DateTime?
  silindi             DateTime?
  baslik              String
  aciklama            String
  onemDerecesi        String // kritik | yuksek | orta | dusuk
  durum               String    @default("acik") // acik | aksiyonda | kapali | kabul_edildi
  kaynak              String? // ic_denetim | dis_denetim | oz_degerlendirme
  tespitTarihi        DateTime  @default(now())
  hedefTarih          DateTime?
  kapanmaTarihi       DateTime?
  sorumluId           String?

  maddeDurumu       MaddeDurumu @relation(fields: [maddeDurumuId], references: [id], onDelete: Cascade)
  sorumlu           Kullanici?  @relation("BulguSorumlusu", fields: [sorumluId], references: [id])
  denetim           Denetim?    @relation(fields: [denetimId], references: [id])
  tekrarBulgu       Bulgu?      @relation("TekrarBulgu", fields: [tekrarBulguId], references: [id])
  tekrarlar         Bulgu[]     @relation("TekrarBulgu")
  kapanisDogrulayan Kullanici?  @relation("BulguKapanisDogrulayan", fields: [kapanisDogrulayanId], references: [id])

  aksiyonlar        Aksiyon[]
  projeBaglantilari ProjeBaglantisi[]
  riskler           Risk[]
  olaylar           OlayBulgu[]

  @@index([durum, onemDerecesi])
}

model Aksiyon {
  id         String    @id @default(cuid())
  bulguId    String
  baslik     String
  aciklama   String?
  sorumluId  String?
  durum      String    @default("planlandi") // planlandi | devam | tamamlandi | iptal
  baslangic  DateTime?
  hedef      DateTime?
  tamamlanma DateTime?

  kokNeden        String?
  dogrulamaDurumu String    @default("gerekmez") // gerekmez | bekliyor | dogrulandi | reddedildi
  dogrulayanId    String?
  dogrulamaTarihi DateTime?
  etkinlikNotu    String?

  bulgu      Bulgu      @relation(fields: [bulguId], references: [id], onDelete: Cascade)
  sorumlu    Kullanici? @relation("AksiyonSorumlusu", fields: [sorumluId], references: [id])
  dogrulayan Kullanici? @relation("AksiyonDogrulayan", fields: [dogrulayanId], references: [id])
}

// ------------------------------------------------------------------- kanıt

model Kanit {
  id                  String   @id @default(cuid())
  ad                  String
  tip                 String // politika | kayit | konfigurasyon | ekran_goruntusu | rapor | log | bilet | onay | test_sonucu | egitim_kaydi | sozlesme | ag_semasi
  dosyaYolu           String?
  gecerlilikBaslangic DateTime @default(now())
  yukleyenId          String?
  olusturuldu         DateTime @default(now())

  // hedef mimari: evidence metadata (§15.1)
  sahipId        String? // evidence owner (yükleyenden farklı olabilir)
  kaynakSistem   String?
  kaynakUrl      String?
  dosyaHash      String?
  surum          Int       @default(1)
  gecerliBitis   DateTime? // valid_until — tazelik motoru bunu izler
  toplanmaTarihi DateTime?
  otomatik       Boolean   @default(false)
  gizlilik       String    @default("kurumsal") // acik | kurumsal | gizli | ot_hassas
  silindi        DateTime?

  yukleyen           Kullanici?        @relation("KanitYukleyen", fields: [yukleyenId], references: [id])
  sahip              Kullanici?        @relation("KanitSahibi", fields: [sahipId], references: [id])
  baglantilar        KanitBaglantisi[]
  varlikBaglantilari KanitVarlik[]
  tesisBaglantilari  KanitTesis[]
  talepler           KanitTalebi[]
}

/// Kanıt ↔ MaddeDurumu çoktan-çoğa: tek kanıt birden çok sürecin/regülasyonun
/// maddesini karşılayabilir (crosswalk).
model KanitBaglantisi {
  id            String   @id @default(cuid())
  kanitId       String
  maddeDurumuId String
  eklendi       DateTime @default(now())

  kanit       Kanit       @relation(fields: [kanitId], references: [id], onDelete: Cascade)
  maddeDurumu MaddeDurumu @relation(fields: [maddeDurumuId], references: [id], onDelete: Cascade)

  @@unique([kanitId, maddeDurumuId])
}

// -------------------------------------------------------------- eşleştirme

model MaddeEslestirmesi {
  id       String  @id @default(cuid())
  kaynakId String
  hedefId  String
  denklik  String // tam | kismi | ilgili
  aciklama String?

  kaynak Madde @relation("EslestirmeKaynak", fields: [kaynakId], references: [id], onDelete: Cascade)
  hedef  Madde @relation("EslestirmeHedef", fields: [hedefId], references: [id], onDelete: Cascade)

  @@unique([kaynakId, hedefId])
}

model Proje {
  id        String    @id @default(cuid())
  kod       String    @unique
  ad        String
  aciklama  String?
  tip       String    @default("iyilestirme") // regulasyon | guvenlik | altyapi | ot | iyilestirme
  gerekce   String? // "bu projeyi neden yapıyoruz" — bağlantı zincirinden türetilir
  silindi   DateTime?
  durum     String    @default("planlandi") // planlandi | devam | tamamlandi | beklemede
  baslangic DateTime?
  hedef     DateTime?
  sahipId   String?

  sahip            Kullanici?         @relation("ProjeSahibi", fields: [sahipId], references: [id])
  baglantilar      ProjeBaglantisi[]
  butceler         Butce[]
  kilometreTaslari KilometreTasi[]
  bagimliOldugu    ProjeBagimliligi[] @relation("BagimliOlan")
  bagimliOlanlar   ProjeBagimliligi[] @relation("BagimliOlunan")
  adaylar          ProjeAdayi[]
  olaylar          OlayProje[]
}

model ProjeBaglantisi {
  id       String  @id @default(cuid())
  projeId  String
  maddeId  String?
  bulguId  String?
  riskId   String?
  tesisId  String?
  varlikId String?
  gerekce  String?

  proje  Proje   @relation(fields: [projeId], references: [id], onDelete: Cascade)
  madde  Madde?  @relation(fields: [maddeId], references: [id], onDelete: Cascade)
  bulgu  Bulgu?  @relation(fields: [bulguId], references: [id], onDelete: Cascade)
  risk   Risk?   @relation(fields: [riskId], references: [id])
  tesis  Tesis?  @relation(fields: [tesisId], references: [id])
  varlik Varlik? @relation(fields: [varlikId], references: [id])

  @@unique([projeId, maddeId, bulguId, riskId, tesisId, varlikId])
}

// --------------------------------------------------------------- yetki/iz

model Kullanici {
  id          String   @id @default(cuid())
  eposta      String   @unique
  adSoyad     String
  unvan       String?
  aktif       Boolean  @default(true)
  parolaHash  String? // scrypt; null = henüz giriş tanımlanmamış
  olusturuldu DateTime @default(now())

  yetkiler          Yetki[]
  durumSorumluluk   MaddeDurumu[]   @relation("DurumSorumlusu")
  bulguSorumluluk   Bulgu[]         @relation("BulguSorumlusu")
  aksiyonSorumluluk Aksiyon[]       @relation("AksiyonSorumlusu")
  yuklenenKanitlar  Kanit[]         @relation("KanitYukleyen")
  sahipProjeler     Proje[]         @relation("ProjeSahibi")
  aktiviteler       AktiviteKaydi[]
  iceAktarimlar     IceAktarim[]

  // hedef mimari genişlemesi
  oturumlar               Oturum[]
  sahipSistemler          SistemServis[]           @relation("SistemSahibi")
  onayladigiKararlar      UygulanabilirlikKarari[] @relation("KararOnaylayan")
  onayladigiIstisnalar    Istisna[]                @relation("IstisnaOnaylayan")
  degerlendirmeleri       DegerlendirmeTarihcesi[]
  sahipRiskler            Risk[]                   @relation("RiskSahibi")
  onayladigiRiskler       Risk[]                   @relation("RiskOnaylayan")
  kanitTalepleri          KanitTalebi[]            @relation("TalepSorumlusu")
  sahipKanitlar           Kanit[]                  @relation("KanitSahibi")
  sahipVarliklar          Varlik[]                 @relation("VarlikSahibi")
  emanetVarliklar         Varlik[]                 @relation("VarlikEmanetcisi")
  erisimIncelemeleri      ErisimIncelemesi[]       @relation("ErisimInceleyen")
  kimlikHesaplari         KimlikHesabi[]
  talepDegisiklikler      Degisiklik[]             @relation("DegisiklikTalep")
  onayDegisiklikler       Degisiklik[]             @relation("DegisiklikOnay")
  adayKararlari           ProjeAdayi[]             @relation("AdayKarari")
  gorevler                Gorev[]                  @relation("GorevSorumlusu")
  bildirimler             Bildirim[]
  onayTalepleri           OnayTalebi[]             @relation("OnayTalepEden")
  verdigiOnaylar          OnayTalebi[]             @relation("OnayVeren")
  dogruladigiBulgular     Bulgu[]                  @relation("BulguKapanisDogrulayan")
  dogruladigiAksiyonlar   Aksiyon[]                @relation("AksiyonDogrulayan")
  // ── entegrasyon katmanı ────────────────────────────────────────────
  apiAnahtarlari          ApiAnahtari[]            @relation("AnahtarSahibi")
  urettigiApiAnahtarlari  ApiAnahtari[]            @relation("AnahtarOlusturan")
  varlikAktarimlari       VarlikAktarimi[]         @relation("AktarimYukleyen")
  onayladigiAktarimlar    VarlikAktarimi[]         @relation("AktarimOnaylayan")
  inceledigiKesifler      KesifKaydi[]             @relation("KesifInceleyen")
  onayladigiAnliklar      TopolojiAnlik[]          @relation("AnlikOnaylayan")
  kararVerdigiSapmalar    TopolojiSapmasi[]        @relation("SapmaKarari")
  dogruladigiOlaylar      Olay[]                   @relation("OlayEtkiDogrulayan")
  dogruladigiKokenler     VeriKokeni[]             @relation("KokenDogrulayan")
  yazdigiEslemeProfilleri EslemeProfili[]          @relation("EslemeOlusturan")
  inceledigiRedler        ReddedilenKayit[]        @relation("RedInceleyen")
}

/// Yetki kapsamı (kullanıcı × uyum süreci × tesis). Alan null ise "tümü".
/// "Denetim bazında yetkilendirme": süreç, denetimin kendisidir.
model Yetki {
  id           String  @id @default(cuid())
  kullaniciId  String
  surecId      String?
  tesisId      String?
  tuzelKisiId  String?
  regulasyonId String? // framework kapsamı
  modul        String? // compliance | envanter | risk | denetim | proje | yonetim — null = tüm modüller
  rol          String // okuyucu | katkici | denetim_sorumlusu | tesis_yoneticisi | ot_yoneticisi | bt_yoneticisi | risk_sahibi | dis_denetci | yonetici

  kullanici Kullanici   @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  surec     UyumSureci? @relation(fields: [surecId], references: [id], onDelete: Cascade)
  tesis     Tesis?      @relation(fields: [tesisId], references: [id], onDelete: Cascade)
  tuzelKisi TuzelKisi?  @relation(fields: [tuzelKisiId], references: [id])

  @@unique([kullaniciId, surecId, tesisId, tuzelKisiId, regulasyonId, modul])
}

/// Değişmez iz kaydı — bulgu zaman çizelgesinin kaynağı. Güncellenmez, yalnızca eklenir.
model AktiviteKaydi {
  id           String   @id @default(cuid())
  aktorId      String?
  varlikTipi   String // Madde | MaddeDurumu | Bulgu | Aksiyon | Kanit | Proje | Yetki | Tesis | UyumSureci | Regulasyon | Risk | Denetim | Varlik | ...
  varlikId     String
  eylem        String // olusturma | guncelleme | silme | yumusak_silme | dosya_ekleme | durum_degisimi | kapsam_degisimi | onay | red
  alan         String?
  oncekiDeger  String?
  yeniDeger    String?
  gerekce      String? // reason (§32)
  kaynak       String   @default("ui") // ui | is_kosusu | entegrasyon | api
  korelasyonId String?
  dosyaAdi     String?
  zaman        DateTime @default(now())

  aktor Kullanici? @relation(fields: [aktorId], references: [id])

  @@index([varlikTipi, varlikId, zaman])
}

// ---------------------------------------------------------- içe aktarım

model IceAktarim {
  id           String   @id @default(cuid())
  regulasyonId String
  surumId      String? // hangi framework sürümüne aktarıldı
  kaynakTipi   String // excel | otomatik
  kaynakAdi    String // dosya adı veya adaptör kimliği
  durum        String   @default("dogrulama_bekliyor") // dogrulama_bekliyor | onaylandi | reddedildi | hata
  okunan       Int      @default(0)
  eklenen      Int      @default(0)
  guncellenen  Int      @default(0)
  elenen       Int      @default(0)
  raporJson    String? // satır önizlemesi, elenenler ve sebepleri
  yukleyenId   String?
  olusturuldu  DateTime @default(now())

  regulasyon Regulasyon       @relation(fields: [regulasyonId], references: [id], onDelete: Cascade)
  surum      FrameworkSurumu? @relation(fields: [surumId], references: [id])
  yukleyen   Kullanici?       @relation(fields: [yukleyenId], references: [id])
}

// ================================================================
// HEDEF MİMARİ GENİŞLEMESİ — docs/ENERJI_IT_OT hedef mimarisine göre
// Additive: mevcut modeller korunur; yeni modüller aşağıda.
// ================================================================

// ------------------------------------------------ organizasyon hiyerarşisi

/// Grup (organizations) — en üst seviye.
model Grup {
  id          String   @id @default(cuid())
  kod         String   @unique
  ad          String
  olusturuldu DateTime @default(now())

  tuzelKisiler TuzelKisi[]
}

/// Tüzel kişi (legal_entities). Tesisler tüzel kişiye bağlanır.
model TuzelKisi {
  id          String   @id @default(cuid())
  grupId      String
  kod         String   @unique
  ad          String
  vergiNo     String?
  olusturuldu DateTime @default(now())

  grup     Grup    @relation(fields: [grupId], references: [id])
  tesisler Tesis[]
  yetkiler Yetki[]
}

/// Üretim ünitesi (generation_units) — santral içindeki üretim birimi.
model UretimUnitesi {
  id           String    @id @default(cuid())
  tesisId      String
  kod          String
  ad           String
  kuruluGucMw  Float?
  devreyeGiris DateTime?
  durum        String    @default("aktif") // aktif | bakim | devre_disi

  tesis     Tesis          @relation(fields: [tesisId], references: [id])
  sistemler SistemServis[]
  varliklar Varlik[]       @relation("UniteVarliklari")

  @@unique([tesisId, kod])
}

/// Sistem/Servis (systems/services) — üretim ünitesi veya tesis seviyesinde.
model SistemServis {
  id        String  @id @default(cuid())
  tesisId   String?
  uniteId   String?
  kod       String  @unique
  ad        String
  tip       String  @default("sistem") // sistem | servis | uygulama
  aciklama  String?
  kritiklik String  @default("bilinmiyor") // dusuk | orta | yuksek | kritik | bilinmiyor
  sahipId   String?

  tesis            Tesis?                   @relation(fields: [tesisId], references: [id])
  unite            UretimUnitesi?           @relation(fields: [uniteId], references: [id])
  sahip            Kullanici?               @relation("SistemSahibi", fields: [sahipId], references: [id])
  surecler         IsSureciSistemi[]
  varliklar        Varlik[]
  riskler          Risk[]
  erisimOturumlari TedarikciErisimOturumu[]
  olaylar          OlaySistem[]
}

/// İş süreci (business_processes) — üretim etkisi analizinin ucu.
model IsSureci {
  id           String  @id @default(cuid())
  tesisId      String?
  kod          String  @unique
  ad           String
  uretimEtkisi String  @default("bilinmiyor") // yok | dusuk | orta | yuksek | uretim_durur | bilinmiyor

  tesis     Tesis?            @relation(fields: [tesisId], references: [id])
  sistemler IsSureciSistemi[]
}

model IsSureciSistemi {
  id       String @id @default(cuid())
  surecId  String
  sistemId String

  surec  IsSureci     @relation(fields: [surecId], references: [id], onDelete: Cascade)
  sistem SistemServis @relation(fields: [sistemId], references: [id], onDelete: Cascade)

  @@unique([surecId, sistemId])
}

/// Santral profili (§5.1) — uygulanabilirlik motorunun girdisi. Tesis 1:1.
model TesisProfili {
  id                   String    @id @default(cuid())
  tesisId              String    @unique
  lisansTipi           String?
  lisansNo             String?
  kabulDurumu          String? // gecici_kabul | kesin_kabul | insaat | lisans_oncesi
  kabulTarihi          DateTime?
  blackStart           Boolean? // null = bilinmiyor
  teiasScadaEms        Boolean? // TEİAŞ SCADA/EMS haberleşmesi
  seriHaberlesme       Boolean? // seri tabanlı haberleşme
  kritiklikSinifi      String? // EPDK kritiklik sınıfı
  kritikAltyapiStatusu Boolean?
  veriIslemeProfili    String?
  internetMaruziyeti   String? // yok | sinirli | var | bilinmiyor
  uzaktanErisim        Boolean?
  otMimariTipi         String? // dcs | scada | plc_scada | hibrit
  dcsSaglayici         String?
  scadaSaglayici       String?
  plcAileleri          String? // noktalı virgülle liste
  iotVar               Boolean?
  akilliSayacVar       Boolean?
  yerelAdVar           Boolean?
  yerelVeriMerkeziVar  Boolean?
  grupOrtakServisler   String? // noktalı virgülle liste (merkezi AD, SOC, EDR...)
  guncellendi          DateTime  @updatedAt

  tesis Tesis @relation(fields: [tesisId], references: [id], onDelete: Cascade)
}

// -------------------------------------------- regülasyon sürümleme ve diff

/// Framework sürümü (framework_versions). Maddeler sürüme bağlanır;
/// yeni sürüm eskini EZMEZ — diff kaydı üretilir.
model FrameworkSurumu {
  id            String    @id @default(cuid())
  regulasyonId  String
  surumEtiketi  String // "2024", "v2.1"...
  yayimTarihi   DateTime?
  yururlukTarih DateTime?
  kaynakUrl     String?
  durum         String    @default("taslak") // taslak | aktif | arsiv
  olusturuldu   DateTime  @default(now())

  regulasyon    Regulasyon   @relation(fields: [regulasyonId], references: [id])
  maddeler      Madde[]
  iceAktarimlar IceAktarim[]
  farklar       SurumFarki[] @relation("YeniSurum")
  eskiFarklar   SurumFarki[] @relation("EskiSurum")

  @@unique([regulasyonId, surumEtiketi])
}

/// Sürüm farkı (diff): iki sürüm arasında madde bazında değişim + etki.
model SurumFarki {
  id          String   @id @default(cuid())
  eskiSurumId String?
  yeniSurumId String
  maddeKodu   String
  degisimTipi String // yeni | degisti | kaldirildi | ayni
  ozet        String?
  etkiNotu    String? // hangi santral/assessment etkilenir
  olusturuldu DateTime @default(now())

  eskiSurum FrameworkSurumu? @relation("EskiSurum", fields: [eskiSurumId], references: [id])
  yeniSurum FrameworkSurumu  @relation("YeniSurum", fields: [yeniSurumId], references: [id])
}

// ---------------------------------------------------- uygulanabilirlik

/// Uygulanabilirlik kuralı (applicability_rules): santral profilinden
/// kapsam türetir. Koşul JSON olarak saklanır, motor değerlendirir.
model UygulanabilirlikKurali {
  id           String   @id @default(cuid())
  regulasyonId String
  ad           String
  kosulJson    String // {"herhangi":[{"alan":"kuruluGucMw","islec":">=","deger":100},...]}
  surum        Int      @default(1)
  aktif        Boolean  @default(true)
  aciklama     String?
  olusturuldu  DateTime @default(now())

  regulasyon Regulasyon               @relation(fields: [regulasyonId], references: [id])
  kararlar   UygulanabilirlikKarari[]
}

/// Uygulanabilirlik kararı (applicability_decisions): tesis × regülasyon
/// kapsam kararı — gerekçesi ve kural sürümüyle. Override onaylıdır.
model UygulanabilirlikKarari {
  id                  String   @id @default(cuid())
  tesisId             String
  regulasyonId        String
  uygulanabilir       Boolean
  gerekce             String
  kuralId             String?
  kuralSurumu         Int?
  hesaplandi          DateTime @default(now())
  elIleDegistirildi   Boolean  @default(false)
  degistirmeGerekcesi String?
  onaylayanId         String?

  tesis      Tesis                   @relation(fields: [tesisId], references: [id])
  regulasyon Regulasyon              @relation(fields: [regulasyonId], references: [id])
  kural      UygulanabilirlikKurali? @relation(fields: [kuralId], references: [id])
  onaylayan  Kullanici?              @relation("KararOnaylayan", fields: [onaylayanId], references: [id])

  @@unique([tesisId, regulasyonId])
}

/// İstisna / waiver (§50): süreli, onaylı, gerekçeli.
model Istisna {
  id          String   @id @default(cuid())
  maddeId     String
  tesisId     String
  gerekce     String
  baslangic   DateTime @default(now())
  bitis       DateTime
  onaylayanId String?
  durum       String   @default("onay_bekliyor") // onay_bekliyor | aktif | suresi_doldu | reddedildi

  madde     Madde      @relation(fields: [maddeId], references: [id])
  tesis     Tesis      @relation(fields: [tesisId], references: [id])
  onaylayan Kullanici? @relation("IstisnaOnaylayan", fields: [onaylayanId], references: [id])
}

// -------------------------------------- assessment tarihçesi ve snapshot

/// Değerlendirme tarihçesi (assessment_history): MaddeDurumu değişimleri
/// SİLİNMEZ — eski değerlendirme burada yaşar.
model DegerlendirmeTarihcesi {
  id            String   @id @default(cuid())
  maddeDurumuId String
  eskiDurum     String
  yeniDurum     String
  eskiGuven     String?
  yeniGuven     String?
  gerekce       String?
  aktorId       String?
  zaman         DateTime @default(now())

  maddeDurumu MaddeDurumu @relation(fields: [maddeDurumuId], references: [id])
  aktor       Kullanici?  @relation(fields: [aktorId], references: [id])

  @@index([maddeDurumuId, zaman])
}

/// Uyum anlık görüntüsü (§44): dönemsel karşılaştırma için.
model UyumAnlik {
  id       String   @id @default(cuid())
  surecId  String
  tesisId  String?
  tarih    DateTime @default(now())
  ozetJson String // durum sayıları, skorlar, güven dağılımı

  surec UyumSureci @relation(fields: [surecId], references: [id])
  tesis Tesis?     @relation(fields: [tesisId], references: [id])

  @@index([surecId, tarih])
}

// ------------------------------------------------------------------ risk

/// Risk kaydı (§13): etki boyutları ayrı; kabul süreli ve onaylı.
model Risk {
  id               String    @id @default(cuid())
  kod              String    @unique
  baslik           String
  aciklama         String
  kaynak           String? // bulgu | zafiyet | eol | denetim | manuel | veri_kalitesi
  tesisId          String?
  sistemId         String?
  bulguId          String?
  tehdit           String?
  zayiflik         String?
  olasilik         Int? // 1-5, null = bilinmiyor
  etkiUretim       Int?
  etkiEmniyet      Int?
  etkiRegulasyon   Int?
  etkiFinans       Int?
  etkiSiber        Int?
  etkiItibar       Int?
  etkiCevre        Int?
  etkiVeri         Int?
  dogalRisk        Int? // inherent
  mevcutKontroller String?
  artikRisk        Int? // residual
  sahipId          String?
  islemTipi        String? // azalt | kacin | devret | kabul
  islemTarihi      DateTime?
  kabulBitis       DateTime? // risk kabulü SÜRELİ
  onaylayanId      String?
  durum            String    @default("acik") // acik | islemde | kabul_edildi | kapali
  silindi          DateTime?
  olusturuldu      DateTime  @default(now())
  guncellendi      DateTime  @updatedAt

  tesis      Tesis?            @relation(fields: [tesisId], references: [id])
  sistem     SistemServis?     @relation(fields: [sistemId], references: [id])
  bulgu      Bulgu?            @relation(fields: [bulguId], references: [id])
  sahip      Kullanici?        @relation("RiskSahibi", fields: [sahipId], references: [id])
  onaylayan  Kullanici?        @relation("RiskOnaylayan", fields: [onaylayanId], references: [id])
  varliklar  RiskVarlik[]
  kontroller RiskKontrol[]
  projeler   ProjeBaglantisi[]
  olaylar    OlayRisk[]

  @@index([durum, tesisId])
}

model RiskVarlik {
  id       String @id @default(cuid())
  riskId   String
  varlikId String

  risk   Risk   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  varlik Varlik @relation(fields: [varlikId], references: [id], onDelete: Cascade)

  @@unique([riskId, varlikId])
}

model RiskKontrol {
  id      String @id @default(cuid())
  riskId  String
  maddeId String

  risk  Risk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  madde Madde @relation(fields: [maddeId], references: [id], onDelete: Cascade)

  @@unique([riskId, maddeId])
}

// --------------------------------------------------------------- denetim

/// Denetim (§14): Plan → Kapsam → Kanıt talebi → Saha → Bulgu → Yanıt →
/// Düzeltici aksiyon → Doğrulama → Kapanış.
model Denetim {
  id            String    @id @default(cuid())
  kod           String    @unique
  ad            String
  tip           String // ic_denetim | dis_denetim | oz_degerlendirme | regulasyon_denetimi
  denetleyen    String? // kurum/firma adı
  surecId       String?
  durum         String    @default("plan") // plan | kapsam | kanit_talebi | saha | bulgu | yanit | aksiyon | dogrulama | kapanis
  planBaslangic DateTime?
  planBitis     DateTime?
  silindi       DateTime?
  olusturuldu   DateTime  @default(now())

  surec     UyumSureci?      @relation(fields: [surecId], references: [id])
  kapsamlar DenetimKapsami[]
  talepler  KanitTalebi[]
  bulgular  Bulgu[]
}

model DenetimKapsami {
  id        String  @id @default(cuid())
  denetimId String
  tesisId   String?
  maddeId   String?

  denetim Denetim @relation(fields: [denetimId], references: [id], onDelete: Cascade)
  tesis   Tesis?  @relation(fields: [tesisId], references: [id])
  madde   Madde?  @relation(fields: [maddeId], references: [id])
}

/// Kanıt talebi (audit_requests): denetimin istediği kanıtlar.
model KanitTalebi {
  id        String    @id @default(cuid())
  denetimId String
  baslik    String
  aciklama  String?
  sorumluId String?
  sonTarih  DateTime?
  durum     String    @default("acik") // acik | saglandi | reddedildi
  kanitId   String?

  denetim Denetim    @relation(fields: [denetimId], references: [id], onDelete: Cascade)
  sorumlu Kullanici? @relation("TalepSorumlusu", fields: [sorumluId], references: [id])
  kanit   Kanit?     @relation(fields: [kanitId], references: [id])
}

// ------------------------------------------------------------------ CMDB

/// Varlık türü — panelden tanımlanır (fiziksel sunucu, sanal sunucu,
/// uygulama, PLC, HMI, SCADA sunucusu, DCS, EWS, ağ cihazı, servis hesabı...)
model VarlikTuru {
  id    String  @id @default(cuid())
  kod   String  @unique
  ad    String
  sinif String  @default("BT") // BT | OT | BT_OT_KOPRU | ORTAK_ALTYAPI | FIZIKSEL_EMNIYET
  aktif Boolean @default(true)

  varliklar Varlik[]
}

/// Varlık (assets, §7.2) — CMDB çekirdeği.
model Varlik {
  id                 String    @id @default(cuid())
  etiket             String    @unique // asset_tag
  ad                 String
  turId              String
  tesisId            String?
  uniteId            String?
  sistemId           String?
  hostname           String?
  seriNo             String?
  uretici            String?
  model              String?
  sahipId            String?
  emanetciId         String? // custodian
  kritiklik          String    @default("bilinmiyor") // dusuk | orta | yuksek | kritik | bilinmiyor
  emniyetEtkisi      String? // safety_impact
  uretimEtkisi       String?
  gizlilik           Int? // C-I-A 1-5
  butunluk           Int?
  erisilebilirlik    Int?
  ipAdresi           String?
  macAdresi          String?
  isletimSistemi     String?
  firmware           String?
  surum              String?
  kurulumTarihi      DateTime?
  garantiBitis       DateTime?
  destekBitis        DateTime? // support_end
  eolTarihi          DateTime?
  eosTarihi          DateTime?
  yamaDurumu         String    @default("bilinmiyor") // guncel | eksik | yamasiz | bilinmiyor
  edrDurumu          String    @default("bilinmiyor") // var | yok | bilinmiyor
  yedekDurumu        String    @default("bilinmiyor")
  izlemeDurumu       String    @default("bilinmiyor")
  logKaynagi         String    @default("bilinmiyor")
  kimlikDogrulama    String?
  internetMaruziyeti String    @default("bilinmiyor") // yok | sinirli | var | bilinmiyor
  uzaktanErisim      Boolean?
  bolgeId            String? // network zone
  rafOda             String?
  tedarikciId        String?
  sozlesmeId         String?
  yasamDongusu       String    @default("aktif") // planlandi | aktif | bakim | emekli | imha
  silindi            DateTime?
  olusturuldu        DateTime  @default(now())
  guncellendi        DateTime  @updatedAt

  tur       VarlikTuru     @relation(fields: [turId], references: [id])
  tesis     Tesis?         @relation(fields: [tesisId], references: [id])
  unite     UretimUnitesi? @relation("UniteVarliklari", fields: [uniteId], references: [id])
  sistem    SistemServis?  @relation(fields: [sistemId], references: [id])
  sahip     Kullanici?     @relation("VarlikSahibi", fields: [sahipId], references: [id])
  emanetci  Kullanici?     @relation("VarlikEmanetcisi", fields: [emanetciId], references: [id])
  bolge     AgBolgesi?     @relation(fields: [bolgeId], references: [id])
  tedarikci Tedarikci?     @relation(fields: [tedarikciId], references: [id])
  sozlesme  Sozlesme?      @relation(fields: [sozlesmeId], references: [id])

  kaynakIliskiler   VarlikIliskisi[]         @relation("IliskiKaynak")
  hedefIliskiler    VarlikIliskisi[]         @relation("IliskiHedef")
  zafiyetler        VarlikZafiyeti[]
  riskler           RiskVarlik[]
  kanitlar          KanitVarlik[]
  hesaplar          ErisimAtamasi[]
  yazilimlar        VarlikYazilimi[]
  sertifikalar      Sertifika[]
  projeBaglantilari ProjeBaglantisi[]
  kesifler          KesifKaydi[]
  konfigYedekleri   KonfigurasyonYedegi[]
  erisimOturumlari  TedarikciErisimOturumu[]
  olaylar           OlayVarlik[]

  @@index([tesisId, kritiklik])
  @@index([eosTarihi])
}

/// Varlık ilişkisi: depends_on | runs_on | connects_to | hosts | backs_up
model VarlikIliskisi {
  id       String @id @default(cuid())
  kaynakId String
  hedefId  String
  tip      String

  kaynak Varlik @relation("IliskiKaynak", fields: [kaynakId], references: [id], onDelete: Cascade)
  hedef  Varlik @relation("IliskiHedef", fields: [hedefId], references: [id], onDelete: Cascade)

  @@unique([kaynakId, hedefId, tip])
}

// ---------------------------------------------------------- ağ topolojisi

model AgBolgesi {
  id               String  @id @default(cuid())
  tesisId          String?
  kod              String  @unique
  ad               String
  tip              String  @default("bt") // bt | ot | dmz | ot_dmz | kurumsal | internet
  guvenlikSeviyesi Int? // Purdue/IEC62443 seviyesi

  tesis          Tesis?     @relation(fields: [tesisId], references: [id])
  varliklar      Varlik[]
  kaynakGecitler AgGeciti[] @relation("GecitKaynak")
  hedefGecitler  AgGeciti[] @relation("GecitHedef")
}

/// Zone-to-zone geçit (conduit): hangi bölge hangi bölgeye, hangi kontrolle.
model AgGeciti {
  id             String    @id @default(cuid())
  kaynakBolgeId  String
  hedefBolgeId   String
  kontrolVarligi String? // firewall/diode varlık etiketi
  protokoller    String?
  onaylandi      Boolean   @default(false)
  /// Geçidin conduit kuralına göre en son ne zaman doğrulandığı (O12).
  /// null = hiç doğrulanmadı; bu SIFIR değil BİLİNMEYEN olarak gösterilir.
  sonDogrulama   DateTime?
  aciklama       String?

  kaynakBolge AgBolgesi @relation("GecitKaynak", fields: [kaynakBolgeId], references: [id])
  hedefBolge  AgBolgesi @relation("GecitHedef", fields: [hedefBolgeId], references: [id])

  @@unique([kaynakBolgeId, hedefBolgeId])
}

// ------------------------------------------------------- kimlik / erişim

/// Kimlik hesabı: kişi hesabı VEYA servis hesabı.
model KimlikHesabi {
  id             String    @id @default(cuid())
  hesapAdi       String    @unique
  tip            String // kisi | servis | paylasimli | acil_durum
  kullaniciId    String? // kişiyse platform kullanıcısı
  tesisId        String?
  kaynakSistem   String? // AD | Entra | yerel | SCADA...
  /// null = ÖLÇÜLMEDİ. Dizin/PAM gözlemi ayrıcalık bilgisi taşımıyorsa
  /// hesabı 'ayrıcalıklı değil' saymak, ayrıcalıklı hesap sayımını
  /// olduğundan düşük gösterir — bilinmeyen sıfır değildir.
  ayricalikli    Boolean?
  parolaRotasyon DateTime?
  sonKullanim    DateTime?
  durum          String    @default("aktif") // aktif | askida | kapatildi

  kullanici        Kullanici?               @relation(fields: [kullaniciId], references: [id])
  tesis            Tesis?                   @relation(fields: [tesisId], references: [id])
  atamalar         ErisimAtamasi[]
  erisimOturumlari TedarikciErisimOturumu[]
}

model ErisimAtamasi {
  id            String    @id @default(cuid())
  hesapId       String
  varlikId      String?
  kapsam        String? // sistem/uygulama adı
  yetkiSeviyesi String? // okuma | yazma | yonetici
  verilis       DateTime  @default(now())
  bitis         DateTime?

  hesap       KimlikHesabi       @relation(fields: [hesapId], references: [id], onDelete: Cascade)
  varlik      Varlik?            @relation(fields: [varlikId], references: [id])
  incelemeler ErisimIncelemesi[]
}

/// Erişim incelemesi (access review): dönemsel onay.
model ErisimIncelemesi {
  id          String   @id @default(cuid())
  atamaId     String
  inceleyenId String?
  sonuc       String // onaylandi | kaldirilsin | degistirilsin
  not         String?
  zaman       DateTime @default(now())

  atama     ErisimAtamasi @relation(fields: [atamaId], references: [id], onDelete: Cascade)
  inceleyen Kullanici?    @relation("ErisimInceleyen", fields: [inceleyenId], references: [id])
}

// ------------------------------------------- tedarikçi / sözleşme / lisans

model Tedarikci {
  id                   String    @id @default(cuid())
  ad                   String    @unique
  tip                  String? // donanim | yazilim | ot_saglayici | hizmet | mssp
  uzaktanErisimVar     Boolean   @default(false)
  /// Uzaktan erişimin nasıl yapıldığı: vpn | jump_host | saticiya_ozel | yok
  uzaktanErisimYontemi String?
  /// Oturum kaydı alınıyor mu. null = bilinmiyor (izlenmiyor DEĞİL).
  oturumKaydiVar       Boolean?
  kritiklik            String    @default("bilinmiyor")
  silindi              DateTime?

  varliklar        Varlik[]
  sozlesmeler      Sozlesme[]
  erisimOturumlari TedarikciErisimOturumu[]
}

model Sozlesme {
  id                  String    @id @default(cuid())
  tedarikciId         String
  kod                 String    @unique
  ad                  String
  baslangic           DateTime?
  bitis               DateTime?
  slaOzeti            String?
  guvenlikSartlariVar Boolean?
  silindi             DateTime?

  tedarikci Tedarikci @relation(fields: [tedarikciId], references: [id])
  varliklar Varlik[]
  lisanslar Lisans[]
}

model YazilimUrunu {
  id        String    @id @default(cuid())
  ad        String
  uretici   String?
  surum     String?
  eolTarihi DateTime?
  eosTarihi DateTime?

  kurulumlar VarlikYazilimi[]
  lisanslar  Lisans[]

  @@unique([ad, surum])
}

model VarlikYazilimi {
  id        String @id @default(cuid())
  varlikId  String
  yazilimId String

  varlik  Varlik       @relation(fields: [varlikId], references: [id], onDelete: Cascade)
  yazilim YazilimUrunu @relation(fields: [yazilimId], references: [id], onDelete: Cascade)

  @@unique([varlikId, yazilimId])
}

model Lisans {
  id         String    @id @default(cuid())
  yazilimId  String
  sozlesmeId String?
  adet       Int?
  bitis      DateTime?
  maliyet    Float?

  yazilim  YazilimUrunu @relation(fields: [yazilimId], references: [id])
  sozlesme Sozlesme?    @relation(fields: [sozlesmeId], references: [id])
}

model Sertifika {
  id       String   @id @default(cuid())
  ad       String
  varlikId String?
  veren    String?
  bitis    DateTime
  durum    String   @default("gecerli") // gecerli | yaklasiyor | suresi_doldu

  varlik Varlik? @relation(fields: [varlikId], references: [id])
}

// ------------------------------------------------- zafiyet / yama / yedek

model Zafiyet {
  id         String   @id @default(cuid())
  /// CVE-… gibi kaynak referansı. TEKİLDİR: aynı zafiyet iki farklı
  /// tarayıcıdan gelse de tek satır olur. null = referanssız (elle
  /// girilmiş) kayıt; SQLite NULL'ları ayrı saydığı için bunlar kısıtın
  /// dışında kalır ve bu kasıtlıdır — referansı olmayan iki kaydın aynı
  /// olduğunu iddia edemeyiz.
  kaynakRef  String?  @unique
  baslik     String
  cvss       Float?
  aciklama   String?
  kesfedildi DateTime @default(now())

  varliklar VarlikZafiyeti[]
}

model VarlikZafiyeti {
  id        String    @id @default(cuid())
  zafiyetId String
  varlikId  String
  durum     String    @default("acik") // acik | yamalandi | azaltildi | kabul_edildi | yanlis_pozitif
  sonTarih  DateTime?
  kapanis   DateTime?

  zafiyet Zafiyet @relation(fields: [zafiyetId], references: [id], onDelete: Cascade)
  varlik  Varlik  @relation(fields: [varlikId], references: [id], onDelete: Cascade)

  @@unique([zafiyetId, varlikId])
}

model YedeklemePolitikasi {
  id           String  @id @default(cuid())
  ad           String
  kapsam       String? // hangi sistem/varlık grubu
  siklik       String? // gunluk | haftalik...
  saklamaGun   Int?
  hedef        String? // yerel | uzak | immutable
  rpoSaat      Int? // kabul edilen veri kaybı penceresi
  rtoSaat      Int? // hedeflenen kurtarma süresi
  haricTutulan String? // kapsam dışı bırakılan kritik sistemler

  kosular YedeklemeKosusu[]
}

model YedeklemeKosusu {
  id         String   @id @default(cuid())
  politikaId String
  zaman      DateTime @default(now())
  durum      String // basarili | basarisiz | kismi
  boyutMb    Float?
  hata       String?

  politika       YedeklemePolitikasi @relation(fields: [politikaId], references: [id], onDelete: Cascade)
  geriYuklemeler GeriYuklemeTesti[]
}

/// Restore testi: yedeğin geri dönebildiğinin KANITI.
model GeriYuklemeTesti {
  id     String   @id @default(cuid())
  kosuId String
  zaman  DateTime @default(now())
  sonuc  String // basarili | basarisiz
  sureDk Int?
  not    String?

  kosu YedeklemeKosusu @relation(fields: [kosuId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------- değişiklik / olay

/// Değişiklik (§19): OT değişikliklerinde emniyet kapıları zorunlu.
model Degisiklik {
  id                 String    @id @default(cuid())
  kod                String    @unique
  baslik             String
  aciklama           String?
  tesisId            String?
  varlikEtiketi      String?
  otMu               Boolean   @default(false)
  saglayiciOnayi     Boolean? // OT ise zorunlu kapı
  bakimPenceresi     String?
  geriAlmaPlani      String?
  onDegisiklikYedegi Boolean?
  uretimEtkisi       String?
  sonDogrulama       String? // post-change verification notu
  durum              String    @default("talep") // talep | onay | planlandi | uygulandi | dogrulandi | geri_alindi
  talepEdenId        String?
  onaylayanId        String?
  planTarihi         DateTime?
  olusturuldu        DateTime  @default(now())

  tesis     Tesis?           @relation(fields: [tesisId], references: [id])
  talepEden Kullanici?       @relation("DegisiklikTalep", fields: [talepEdenId], references: [id])
  onaylayan Kullanici?       @relation("DegisiklikOnay", fields: [onaylayanId], references: [id])
  olaylar   OlayDegisiklik[]
}

model Olay {
  id        String    @id @default(cuid())
  kod       String    @unique
  baslik    String
  tip       String    @default("olay") // olay | problem
  tesisId   String?
  siddet    String    @default("orta") // dusuk | orta | yuksek | kritik
  durum     String    @default("acik") // acik | mudahale | cozuldu | kapali
  baslangic DateTime  @default(now())
  cozum     DateTime?
  ozet      String?

  // ── etki zinciri genişletmesi ──────────────────────────────────────
  /// siem | operator | tedarikci | denetim | musteri | otomatik_kural
  tespitKaynagi       String?
  /// Etki boyutları AYRI tutulur: bir olayın üretimi durdurmadan
  /// regülasyon bildirimi doğurması olağandır. null = DEĞERLENDİRİLMEDİ.
  uretimEtkisi        String? // yok | dusuk | orta | yuksek | uretim_durdu
  emniyetEtkisi       String?
  regulasyonEtkisi    String?
  siberEtki           String?
  kokNeden            String?
  sinirlama           String? // containment
  kurtarma            String? // recovery
  ogrenilenler        String?
  bildirimGerekli     Boolean?
  bildirimTarihi      DateTime?
  /// Motorun ÖNERİSİ. İnsan doğrulayana kadar etki alanlarına yazılmaz —
  /// otomasyon önerir, karar vermez.
  etkiOnerisiJson     String?
  etkiDogrulayanId    String?
  etkiDogrulamaZamani DateTime?

  tesis          Tesis?     @relation(fields: [tesisId], references: [id])
  etkiDogrulayan Kullanici? @relation("OlayEtkiDogrulayan", fields: [etkiDogrulayanId], references: [id])

  varliklar     OlayVarlik[]
  sistemler     OlaySistem[]
  riskler       OlayRisk[]
  bulgular      OlayBulgu[]
  projeler      OlayProje[]
  degisiklikler OlayDegisiklik[]
}

// ----------------------------------------------- proje/bütçe genişlemesi

model Butce {
  id         String @id @default(cuid())
  projeId    String
  yil        Int
  tip        String // capex | opex
  planlanan  Float
  harcanan   Float  @default(0)
  paraBirimi String @default("TRY")

  proje Proje @relation(fields: [projeId], references: [id], onDelete: Cascade)

  @@unique([projeId, yil, tip])
}

model KilometreTasi {
  id          String    @id @default(cuid())
  projeId     String
  ad          String
  hedef       DateTime
  gerceklesen DateTime?
  durum       String    @default("planlandi") // planlandi | tamamlandi | gecikti

  proje Proje @relation(fields: [projeId], references: [id], onDelete: Cascade)
}

model ProjeBagimliligi {
  id             String @id @default(cuid())
  projeId        String
  bagimliProjeId String

  proje        Proje @relation("BagimliOlan", fields: [projeId], references: [id], onDelete: Cascade)
  bagimliProje Proje @relation("BagimliOlunan", fields: [bagimliProjeId], references: [id], onDelete: Cascade)

  @@unique([projeId, bagimliProjeId])
}

/// Proje adayı (§17): motorlar üretir, İNSAN ONAYI olmadan projeye dönmez.
model ProjeAdayi {
  id           String   @id @default(cuid())
  baslik       String
  gerekce      String // "neden bu proje" — otomatik üretilen gerekçe
  kaynak       String // regulatory_gap | kritik_risk | tekrar_bulgu | eol_eos | yedek_dr | zafiyet_trendi | yeni_regulasyon
  kaynakRef    String? // ilgili kaydın id'si
  tesisId      String?
  durum        String   @default("oneri") // oneri | onaylandi | reddedildi | projeye_donustu
  projeId      String? // dönüştüyse
  olusturuldu  DateTime @default(now())
  kararVerenId String?

  tesis      Tesis?     @relation(fields: [tesisId], references: [id])
  proje      Proje?     @relation(fields: [projeId], references: [id])
  kararVeren Kullanici? @relation("AdayKarari", fields: [kararVerenId], references: [id])
}

// ------------------------------------------ kanıt genişleme bağlantıları

model KanitVarlik {
  id       String @id @default(cuid())
  kanitId  String
  varlikId String

  kanit  Kanit  @relation(fields: [kanitId], references: [id], onDelete: Cascade)
  varlik Varlik @relation(fields: [varlikId], references: [id], onDelete: Cascade)

  @@unique([kanitId, varlikId])
}

model KanitTesis {
  id      String @id @default(cuid())
  kanitId String
  tesisId String

  kanit Kanit @relation(fields: [kanitId], references: [id], onDelete: Cascade)
  tesis Tesis @relation(fields: [tesisId], references: [id], onDelete: Cascade)

  @@unique([kanitId, tesisId])
}

// --------------------------------------- oturum / görev / bildirim / onay

model Oturum {
  id          String   @id @default(cuid())
  kullaniciId String
  tokenHash   String   @unique
  olusturuldu DateTime @default(now())
  sonKullanim DateTime @default(now())
  bitis       DateTime

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@index([kullaniciId])
}

/// Görev motoru (§52): sistem üretir (kanıt yenileme, süre yaklaşan,
/// erişim incelemesi...), insan kapatır.
model Gorev {
  id               String    @id @default(cuid())
  baslik           String
  tip              String // kanit_yenileme | son_tarih | erisim_incelemesi | dogrulama | veri_kalitesi | manuel
  kaynakTipi       String? // ilişkili varlık tipi
  kaynakId         String?
  sorumluId        String?
  tesisId          String?
  sonTarih         DateTime?
  durum            String    @default("acik") // acik | yapiliyor | tamamlandi | iptal
  otomatikUretildi Boolean   @default(false)
  olusturuldu      DateTime  @default(now())
  kapanis          DateTime?

  sorumlu Kullanici? @relation("GorevSorumlusu", fields: [sorumluId], references: [id])
  tesis   Tesis?     @relation(fields: [tesisId], references: [id])

  @@index([durum, sonTarih])
}

model Bildirim {
  id          String    @id @default(cuid())
  kullaniciId String
  baslik      String
  govde       String?
  tip         String    @default("bilgi") // bilgi | uyari | eskalasyon
  kaynakTipi  String?
  kaynakId    String?
  okundu      DateTime?
  olusturuldu DateTime  @default(now())

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@index([kullaniciId, okundu])
}

/// Onay talebi (§30): kritik işlemler onay akışından geçer.
model OnayTalebi {
  id          String    @id @default(cuid())
  tip         String // bulgu_kapanis | risk_kabul | istisna | proje_aday | applicability_override | proje_kapanis
  kaynakTipi  String
  kaynakId    String
  ozet        String
  talepEdenId String?
  onaylayanId String?
  durum       String    @default("bekliyor") // bekliyor | onaylandi | reddedildi
  gerekce     String?
  olusturuldu DateTime  @default(now())
  kapanis     DateTime?

  talepEden Kullanici? @relation("OnayTalepEden", fields: [talepEdenId], references: [id])
  onaylayan Kullanici? @relation("OnayVeren", fields: [onaylayanId], references: [id])

  @@index([durum, tip])
}

// -------------------------------------- iş koşuları / veri kalitesi / sağlık

/// Arka plan iş koşusu (§68): sessiz hata YASAK — her koşu iz bırakır.
model IsKosusu {
  id        String    @id @default(cuid())
  isAdi     String // deadline_motoru | kanit_tazelik | gap_to_action | veri_kalitesi | applicability | surum_diff
  baslangic DateTime  @default(now())
  bitis     DateTime?
  durum     String    @default("calisiyor") // calisiyor | basarili | basarisiz
  sureMs    Int?
  islenen   Int       @default(0)
  uretilen  Int       @default(0)
  hata      String?
  denemeNo  Int       @default(1)

  @@index([isAdi, baslangic])
}

model EntegrasyonKosusu {
  id           String    @id @default(cuid())
  kaynak       String // AD | EDR | vuln_scanner | backup | manual_import
  baslangic    DateTime  @default(now())
  bitis        DateTime?
  durum        String    @default("calisiyor")
  kayitSayisi  Int       @default(0)
  guvenEtiketi String    @default("manuel") // otomatik | manuel | dogrulanmis
  hata         String?
  /// Hata OLMAYAN açıklama: hangi kimlik eksik, kaç kayıt neden reddedildi,
  /// kaynak neden yok. `hata` alanı yalnız gerçek başarısızlık taşır;
  /// ikisini karıştırmak sağlık ekranını yanlış renklendiriyordu.
  ayrinti      String?

  // ── connector çatısı genişletmesi ──────────────────────────────────
  connectorId String?
  /// manuel | zamanlanmis | api
  tetikleyen  String  @default("manuel")
  /// Sayaçlar ayrı tutulur: "alınan" ile "kabul edilen" aynı şey değildir
  /// ve reddedilen kayıt sessizce yok sayılmaz.
  alinan      Int     @default(0)
  kabulEdilen Int     @default(0)
  reddedilen  Int     @default(0)
  yinelenen   Int     @default(0)
  sureMs      Int?
  denemeNo    Int     @default(1)
  /// delta senkronizasyon imleci — koşu öncesi/sonrası
  imlecOnce   String?
  imlecSonra  String?

  /// KURU KOŞU: kayıt yazılmaz, yalnız ne olacağı hesaplanır. Ayrı bir
  /// alan olarak durur ki sağlık ekranı kuru koşuyu gerçek koşuyla
  /// karıştırmasın — "son başarılı koşu" bir kuru koşuysa o entegrasyon
  /// hâlâ hiç veri getirmemiştir.
  kuruKosu           Boolean @default(false)
  /// Kuru koşunun "olsaydı ne olurdu" sayaçları (JSON). Gerçek koşuda null.
  kuruOzetJson       String?
  /// Hatanın PARMAK İZİ: aynı hata tekrar mı ediyor, ucuzca anlaşılsın.
  /// Mesajın kendisi değişken (zaman damgası, id) taşıyabilir; parmak izi
  /// sınıf + normalize edilmiş metinden türetilir.
  hataOzeti          String?
  /// gecici | kalici — ağ/zaman aşımı gibi GEÇİCİ hatalar ile
  /// yapılandırma/yetki gibi KALICI hatalar ayrı raporlanır; ikisini
  /// karıştırmak "tekrar dene" düğmesini anlamsız yapar.
  hataSinifi         String?
  /// Bu koşuyu tetikleyen dış istek/zincir kimliği — uçtan uca izleme.
  korelasyonId       String?
  /// Koşunun kullandığı eşleme profili sürümü (varsa).
  eslemeProfilSurumu Int?

  connector     Connector?        @relation(fields: [connectorId], references: [id])
  reddedilenler ReddedilenKayit[]

  @@index([connectorId, baslangic])
}

model VeriKalitesiBulgusu {
  id          String    @id @default(cuid())
  kural       String // sahipsiz_varlik | kritikligi_bilinmeyen | bayat_kayit | eksik_profil | envanteri_bos_tesis
  kaynakTipi  String
  kaynakId    String
  aciklama    String
  durum       String    @default("acik") // acik | cozuldu | yok_sayildi
  olusturuldu DateTime  @default(now())
  kapanis     DateTime?

  @@index([kural, durum])
}

// ═══════════════════════════════════════════════════════════════════════
// ENTEGRASYON VE OTOMASYON KATMANI
//
// Tasarım ilkeleri:
//  · Otomasyon ÖNERİR, karar vermez: detect → correlate → propose → approve.
//  · Sır veritabanında tutulmaz; Connector yalnız bir referans taşır.
//  · Bilinmeyen ≠ sıfır: ölçülmemiş güven null'dır, 0 değil.
//  · Kaynağı bilinmeyen veri "otomatik" sayılmaz; kökeni yoksa manueldir.
// ═══════════════════════════════════════════════════════════════════════

/// Dış sistem bağlayıcısı. Kimlik bilgisi BURADA DURMAZ: `sirReferansi`
/// yalnız sırra giden adresi taşır (env:ANAHTAR, dosya:/run/secrets/x#alan).
model Connector {
  id               String  @id @default(cuid())
  kod              String  @unique
  ad               String
  /// ad_entra | vuln_scanner | edr | siem | backup | network_firewall |
  /// ot_discovery | manual_import
  tip              String
  /// taslak | etkin | duraklatildi | hatali | kimlik_bekleniyor
  /// kimlik_bekleniyor: yapılandırma tam ama dış sistem kimlik bilgisi yok.
  /// Bu bir HATA DEĞİLDİR — bekleyen bir kurulum adımıdır ve sağlık
  /// ekranında kırmızı değil, bekliyor olarak gösterilir.
  durum            String  @default("taslak")
  kaynakSistem     String
  /// none | api_key | basic | oauth2_client_credentials | certificate
  kimlikTipi       String  @default("none")
  /// bağlantı ayarları — SIR İÇERMEZ (host, port, taban URL, filtre…)
  yapilandirmaJson String?
  sirReferansi     String?
  /// dakika; null = yalnız elle tetiklenir
  pollAralikDk     Int?

  /// Hangi ortamın sistemine bakıyor: gelistirme | test | uretim.
  /// Bir connector'ın hangi ortama baktığı bir GÜVENLİK bilgisidir —
  /// üretim OT ağına bakan bir kaydı test sanıp etkinleştirmek en kolay
  /// yapılan hatadır; ekran bunu ayrı gösterir.
  ortam               String  @default("gelistirme")
  /// tam | delta — delta imleç kullanır, tam her koşuda hepsini çeker.
  senkronKipi         String  @default("delta")
  /// En fazla kaç deneme; null = çekirdek varsayılanı.
  maksDeneme          Int?
  /// Geri çekilme taban süresi (ms); null = çekirdek varsayılanı.
  geriCekilmeMs       Int?
  /// Ardışık kaç başarısızlıktan sonra connector otomatik duraklatılır.
  /// null = duraklatma yok. Devre kesici burada YALNIZ SAYILIR; kararı
  /// çekirdek verir ve durum 'hatali' olur — sessizce koşmaya devam
  /// etmek, ölü bir entegrasyonu canlı göstermek olurdu.
  ardisikHataSiniri   Int?
  /// Şu ana kadarki ardışık başarısızlık sayısı (başarıda sıfırlanır).
  ardisikHata         Int     @default(0)
  /// Bu connector'ın YAZABİLECEĞİ santraller. Boş = kapsam sınırı yok.
  /// Kapsam connector düzeyinde de tutulur, çünkü bir OT keşif ürünü
  /// yalnız kendi sahasını görür; kaydın beyan ettiği santrale güvenmek
  /// yanlış yapılandırılmış bir kaynağın başka sahaya yazmasına izin verir.
  kapsamTesisleriJson String?
  /// Etkin eşleme profili — null ise adaptörün gömülü eşlemesi kullanılır.
  eslemeProfilId      String?

  sonBasariliKosu DateTime?
  sonHata         String?
  /// Son hatanın parmak izi — aynı hata tekrar ediyor mu, ucuzca anlaşılsın.
  sonHataOzeti    String?
  etkin           Boolean   @default(false)
  /// delta senkronizasyon imleci — adaptör yorumlar
  imlec           String?
  silindi         DateTime?
  olusturuldu     DateTime  @default(now())
  guncellendi     DateTime  @updatedAt

  kosular       EntegrasyonKosusu[]
  kesifler      KesifKaydi[]
  eslemeProfil  EslemeProfili?      @relation(fields: [eslemeProfilId], references: [id])
  reddedilenler ReddedilenKayit[]

  @@index([tip, etkin])
}

/// Otomatik gelen kaydın kökeni. Polimorfiktir: on beş tabloyu genişletmek
/// yerine tek yerde tutulur. Kaynağı gerçekten bilinmeyen kayıt için satır
/// AÇILMAZ — kökeni olmayan kayıt manueldir.
/// Eşleme profili — kaynak alanından hedef alana çevirinin SÜRÜMLÜ tanımı.
///
/// Neden sürümlü: gerçek sistem bağlandığında en çok vakit alan iş eşleme
/// olacak ve eşleme DEĞİŞECEK. Eski içe aktarımların hangi kuralla
/// yorumlandığı kaybolursa bir denetimde "bu alan neden böyle" sorusunun
/// yanıtı olmaz. Yeni sürüm ESKİSİNİ EZMEZ: yeni satır açılır, eski satır
/// arşive geçer ve VeriKokeni.eslemeProfilSurumu hangi sürümle
/// yorumlandığını taşır.
model EslemeProfili {
  id            String   @id @default(cuid())
  kod           String
  ad            String
  /// hangi connector tipi için — profil TİPE aittir, tek bir connector'a
  /// değil; böylece aynı profil birden çok connector'da kullanılabilir
  connectorTipi String
  surum         Int      @default(1)
  /// taslak | etkin | arsiv — yalnız 'etkin' olan koşuda kullanılır
  durum         String   @default("taslak")
  /// kural listesi (JSON): [{ kaynakAlan, hedefAlan, donusum, zorunlu,
  /// varsayilan, enumEsleme, guvenKurali }]
  kurallarJson  String
  aciklama      String?
  olusturanId   String?
  olusturuldu   DateTime @default(now())

  olusturan    Kullanici?  @relation("EslemeOlusturan", fields: [olusturanId], references: [id])
  connectorlar Connector[]

  @@unique([kod, surum])
  @@index([connectorTipi, durum])
}

/// Reddedilen kayıt (dead-letter / inceleme kuyruğu).
///
/// Bir kaydın reddedilmesi bir SAYIDAN ibaret olamaz: hangi kayıt, neden,
/// hangi aşamada, ham hâli neydi — bunlar olmadan kimse düzeltemez. Sayaç
/// EntegrasyonKosusu.reddedilen alanında duruyordu ama kaydın kendisi
/// kayboluyordu; "3 kayıt reddedildi" bir kusur raporu değil, bir kusurun
/// ilanıdır.
model ReddedilenKayit {
  id             String    @id @default(cuid())
  kosuId         String?
  connectorId    String?
  kaynakSistem   String
  /// kaynak kaydın kimliği — biliniyorsa; bilinmiyorsa null (öyle geldi)
  kaynakKayitId  String?
  /// sema | normalize | esleme | dogrulama | eslesme | kapsam | yazma
  ///
  /// `esleme` ile `eslesme` AYRI aşamalardır ve karıştırılmaları kaydın
  /// hangi adımda düştüğünü yanlış gösterir:
  ///   esleme  = eşleme profili kaynağın alanlarını hedef alanlara çevirir
  ///             (ör. tanınmayan enum değeri).
  ///   eslesme = normalleşmiş kayıt CMDB'deki bir varlıkla eşleştirilir
  ///             (ör. hiçbir anahtar tutmadı).
  asama          String
  sebep          String
  /// ham kayıt — SIR İÇERMEZ (çekirdek sırları maskeleyerek yazar)
  hamJson        String?
  /// acik | incelendi | duzeltildi | yok_sayildi
  durum          String    @default("acik")
  inceleyenId    String?
  incelemeNotu   String?
  incelemeZamani DateTime?
  olusturuldu    DateTime  @default(now())

  kosu      EntegrasyonKosusu? @relation(fields: [kosuId], references: [id], onDelete: Cascade)
  connector Connector?         @relation(fields: [connectorId], references: [id])
  inceleyen Kullanici?         @relation("RedInceleyen", fields: [inceleyenId], references: [id])

  @@index([durum, olusturuldu])
  @@index([connectorId, asama])
}

model VeriKokeni {
  id              String    @id @default(cuid())
  varlikTipi      String // Varlik | Zafiyet | YedeklemeKosusu | ErisimAtamasi …
  varlikId        String
  /// manuel | otomatik | dogrulanmis
  kokenTipi       String
  kaynakSistem    String
  /// Kaynak sistemdeki birincil anahtar. ZORUNLU: nullable olsaydı SQLite
  /// tekillik kısıtı iş görmezdi (NULL'lar birbirinden farklı sayılır) ve
  /// yeniden senkronizasyon her koşuda yeni satır açardı. Kaynağın kararlı
  /// bir kimliği yoksa adaptör kimlik alanlarından türetilmiş bir özet üretir.
  kaynakKayitId   String
  connectorId     String?
  kosuId          String?
  toplanma        DateTime?
  aktarim         DateTime  @default(now())
  /// 0–1; null = ÖLÇÜLMEDİ (sıfır güven değil)
  guven           Float?
  /// dogrulanmadi | dogrulandi | reddedildi
  dogrulamaDurumu String    @default("dogrulanmadi")
  dogrulayanId    String?
  dogrulamaZamani DateTime?

  /// Kaydın hangi eşleme profili SÜRÜMÜYLE yorumlandığı. Eşleme değişince
  /// eski kayıtların hangi kuralla üretildiği kaybolmamalı — yoksa bir
  /// denetimde "bu alan neden böyle" sorusunun yanıtı olmaz.
  eslemeProfilSurumu Int?
  /// Ham kaydın özeti (SHA-256, onaltılık). Aynı kaynak kaydı içerik
  /// değişmeden yeniden geldiğinde güncelleme yapılmasına gerek yok;
  /// ayrıca "kaynak ne gönderdi" sorusu kanıtlanabilir kalır.
  /// null = özet hesaplanmadı (eski kayıt ya da hesaplanamayan biçim).
  kayitOzeti         String?

  dogrulayan Kullanici? @relation("KokenDogrulayan", fields: [dogrulayanId], references: [id])

  @@unique([varlikTipi, varlikId, kaynakSistem, kaynakKayitId])
  @@index([varlikTipi, varlikId])
  @@index([kokenTipi, dogrulamaDurumu])
}

/// Keşfedilen ham kayıt. CMDB'ye DOĞRUDAN yazılmaz:
/// kesfedildi → normalize → eslesti → inceleme_bekliyor → onaylandi → Varlik
model KesifKaydi {
  id              String    @id @default(cuid())
  connectorId     String?
  kosuId          String?
  /// firewall | switch_arp | dhcp | snmp | siem | historian | scada_export |
  /// vendor_export | csv
  kaynak          String
  kaynakKayitId   String
  /// Kaydın BEYAN EDİLEN santrali: gözlemdeki tesis kodundan ya da
  /// connector yapılandırmasından çözülür. Henüz bir varlığa eşlenmemiş
  /// kaydın kapsamı buradan bilinir; null = santral BİLİNMİYOR (hiçbir
  /// santrale ait değil demek DEĞİL).
  tesisId         String?
  /// ham gözlem — dokunulmaz, denetim izinin girdisi
  hamJson         String
  normalJson      String?
  /// kesfedildi | normalize | eslesti | inceleme_bekliyor | onaylandi |
  /// reddedildi | yinelenen
  durum           String    @default("kesfedildi")
  eslesenVarlikId String?
  /// seri | mac | hostname | ip | etiket | uretici_model
  eslesmeAnahtari String?
  /// 0–1; null = hesaplanamadı
  guvenSkoru      Float?
  inceleyenId     String?
  incelemeZamani  DateTime?
  incelemeNotu    String?
  ilkGorulme      DateTime  @default(now())
  sonGorulme      DateTime  @default(now())

  connector     Connector? @relation(fields: [connectorId], references: [id])
  tesis         Tesis?     @relation(fields: [tesisId], references: [id])
  eslesenVarlik Varlik?    @relation(fields: [eslesenVarlikId], references: [id])
  inceleyen     Kullanici? @relation("KesifInceleyen", fields: [inceleyenId], references: [id])

  @@unique([kaynak, kaynakKayitId])
  @@index([durum, sonGorulme])
  @@index([tesisId, durum])
}

/// Topoloji anlık görüntüsü. `temelMi` işaretli anlık BASELINE'dır ve
/// sapma buna göre hesaplanır.
model TopolojiAnlik {
  id          String    @id @default(cuid())
  tesisId     String?
  kaynak      String
  alindi      DateTime  @default(now())
  /// gözlem kümesinin özeti — iki anlık aynı mı, ucuzca anlaşılsın
  ozetHash    String
  temelMi     Boolean   @default(false)
  onaylayanId String?
  onayZamani  DateTime?
  not         String?

  tesis     Tesis?            @relation(fields: [tesisId], references: [id])
  onaylayan Kullanici?        @relation("AnlikOnaylayan", fields: [onaylayanId], references: [id])
  gozlemler TopolojiGozlemi[]
  sapmalar  TopolojiSapmasi[]

  @@index([tesisId, alindi])
}

model TopolojiGozlemi {
  id          String @id @default(cuid())
  anlikId     String
  /// dugum | gecit | baglanti
  tip         String
  /// kimlik anahtarı: dugum→etiket/ip, gecit→"kaynakBolge>hedefBolge"
  anahtar     String
  ozellikJson String

  anlik TopolojiAnlik @relation(fields: [anlikId], references: [id], onDelete: Cascade)

  @@index([anlikId, tip])
}

/// Sapma OTOMATİK DEĞİŞİKLİK YAPMAZ: gozlendi → inceleme → kabul/ret.
/// Kabul edilirse yeni temel yazılır; reddedilirse temel korunur.
model TopolojiSapmasi {
  id              String    @id @default(cuid())
  tesisId         String?
  anlikId         String
  /// yeni_dugum | kayip_dugum | ip_degisti | bolge_degisti | yeni_gecit |
  /// silinen_gecit | beklenmeyen_protokol | yol_degisti |
  /// yeni_bt_ot_koprusu | yetkisiz_dogrudan_baglanti
  tip             String
  siddet          String    @default("orta") // dusuk | orta | yuksek | kritik
  aciklama        String
  oncekiJson      String?
  sonrakiJson     String?
  /// gozlendi | inceleme | kabul | ret
  durum           String    @default("gozlendi")
  kararVerenId    String?
  kararZamani     DateTime?
  kararGerekcesi  String?
  /// kritik sapma risk/bulgu ADAYI üretir; kaydı insan açar
  uretilenRiskId  String?
  uretilenBulguId String?
  olusturuldu     DateTime  @default(now())

  anlik      TopolojiAnlik @relation(fields: [anlikId], references: [id], onDelete: Cascade)
  kararVeren Kullanici?    @relation("SapmaKarari", fields: [kararVerenId], references: [id])

  @@index([durum, siddet])
}

/// Varlık seviyesinde konfigürasyon yedeği. YedeklemePolitikasi santral
/// seviyesindedir ve yerini almaz — bu onu tamamlar.
model KonfigurasyonYedegi {
  id              String    @id @default(cuid())
  varlikId        String
  kaynakSistem    String
  /// Kaynak sistemdeki kaydın kimliği. Idempotency buna dayanır ve
  /// kısıt VERİTABANINDA durur: köken tablosu üzerinden arama yapan
  /// iki eşzamanlı içe aktarım aynı yedeği iki kez yazamasın.
  kaynakKayitId   String
  yedekZamani     DateTime
  surum           String?
  /// içerik özeti — konfigürasyon gerçekten değişmiş mi
  icerikHash      String?
  basarili        Boolean   @default(true)
  /// yedeğin okunabilirliği doğrulandı mı (restore testinden farklıdır)
  dogrulandi      Boolean   @default(false)
  dogrulamaZamani DateTime?
  /// GeriYuklemeTesti kaydına yumuşak referans
  restoreTestId   String?
  depolamaKonumu  String?
  saklamaGun      Int?
  /// varlığın bilinen son ÇALIŞIR konfigürasyonu
  sonBilinenIyi   Boolean   @default(false)
  hata            String?

  varlik Varlik @relation(fields: [varlikId], references: [id], onDelete: Cascade)

  @@unique([kaynakSistem, kaynakKayitId])
  @@index([varlikId, yedekZamani])
}

/// Platform PAM/VPN ürünü DEĞİLDİR: oturumu yönetmez, metadata ve uyum
/// sonucunu gösterir. Kayıt ancak gerçek bir kaynaktan gelirse yazılır.
model TedarikciErisimOturumu {
  id             String    @id @default(cuid())
  tedarikciId    String
  hesapId        String?
  tesisId        String?
  varlikId       String?
  sistemId       String?
  baslangic      DateTime
  bitis          DateTime?
  kaynakSistem   String
  /// Kaynak sistemdeki oturum kimliği — idempotency anahtarı (yukarıdaki
  /// KonfigurasyonYedegi notuyla aynı gerekçe).
  kaynakKayitId  String
  /// null = BİLİNMİYOR (onaysız değil)
  onayli         Boolean?
  mfaVar         Boolean?
  izlendi        Boolean?
  talepReferansi String?
  kayitReferansi String?
  /// suruyor | tamamlandi | kesildi
  durum          String    @default("tamamlandi")

  tedarikci Tedarikci     @relation(fields: [tedarikciId], references: [id])
  hesap     KimlikHesabi? @relation(fields: [hesapId], references: [id])
  tesis     Tesis?        @relation(fields: [tesisId], references: [id])
  varlik    Varlik?       @relation(fields: [varlikId], references: [id])
  sistem    SistemServis? @relation(fields: [sistemId], references: [id])

  @@unique([kaynakSistem, kaynakKayitId])
  @@index([tedarikciId, baslangic])
}

// ── olay etki zinciri bağ tabloları ──────────────────────────────────

model OlayVarlik {
  id       String @id @default(cuid())
  olayId   String
  varlikId String
  /// etkilenen | kaynak | telafi_edici
  rol      String @default("etkilenen")

  olay   Olay   @relation(fields: [olayId], references: [id], onDelete: Cascade)
  varlik Varlik @relation(fields: [varlikId], references: [id], onDelete: Cascade)

  @@unique([olayId, varlikId])
}

model OlaySistem {
  id       String @id @default(cuid())
  olayId   String
  sistemId String
  rol      String @default("etkilenen")

  olay   Olay         @relation(fields: [olayId], references: [id], onDelete: Cascade)
  sistem SistemServis @relation(fields: [sistemId], references: [id], onDelete: Cascade)

  @@unique([olayId, sistemId])
}

model OlayRisk {
  id     String @id @default(cuid())
  olayId String
  riskId String

  olay Olay @relation(fields: [olayId], references: [id], onDelete: Cascade)
  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([olayId, riskId])
}

model OlayBulgu {
  id      String @id @default(cuid())
  olayId  String
  bulguId String

  olay  Olay  @relation(fields: [olayId], references: [id], onDelete: Cascade)
  bulgu Bulgu @relation(fields: [bulguId], references: [id], onDelete: Cascade)

  @@unique([olayId, bulguId])
}

model OlayProje {
  id      String @id @default(cuid())
  olayId  String
  projeId String

  olay  Olay  @relation(fields: [olayId], references: [id], onDelete: Cascade)
  proje Proje @relation(fields: [projeId], references: [id], onDelete: Cascade)

  @@unique([olayId, projeId])
}

model OlayDegisiklik {
  id           String @id @default(cuid())
  olayId       String
  degisiklikId String

  olay       Olay       @relation(fields: [olayId], references: [id], onDelete: Cascade)
  degisiklik Degisiklik @relation(fields: [degisiklikId], references: [id], onDelete: Cascade)

  @@unique([olayId, degisiklikId])
}

// ── dış sistem API'si ────────────────────────────────────────────────

/// Servis hesabı anahtarı. Token saklanmaz, yalnız SHA-256 özeti tutulur.
/// Yetki anahtara bağlı KULLANICI üzerinden mevcut RBAC ile çözülür —
/// paralel bir yetki sistemi kurulmaz.
model ApiAnahtari {
  id          String    @id @default(cuid())
  ad          String
  kullaniciId String
  /// gösterim için ilk karakterler; tam token asla saklanmaz
  onEk        String
  tokenHash   String    @unique
  sonKullanim DateTime?
  bitis       DateTime?
  iptalZamani DateTime?
  olusturanId String?
  olusturuldu DateTime  @default(now())

  kullanici Kullanici   @relation("AnahtarSahibi", fields: [kullaniciId], references: [id], onDelete: Cascade)
  olusturan Kullanici?  @relation("AnahtarOlusturan", fields: [olusturanId], references: [id])
  istekler  ApiIstegi[]

  @@index([kullaniciId])
}

/// İdempotency defteri ve API denetim izi. Aynı Idempotency-Key ile gelen
/// ikinci istek işi TEKRAR ETMEZ, ilk yanıtı döner.
model ApiIstegi {
  id                  String   @id @default(cuid())
  anahtarId           String?
  yontem              String
  yol                 String
  idempotencyAnahtari String?
  durumKodu           Int
  yanitOzeti          String?
  hataKodu            String?
  sureMs              Int?
  zaman               DateTime @default(now())

  anahtar ApiAnahtari? @relation(fields: [anahtarId], references: [id], onDelete: Cascade)

  @@unique([anahtarId, idempotencyAnahtari])
  @@index([yol, zaman])
  @@index([anahtarId, zaman])
}

/// Varlık toplu aktarımı. IceAktarim regülasyon maddesine bağlıdır
/// (regulasyonId zorunlu) ve genel varlık aktarımı için kullanılamaz.
model VarlikAktarimi {
  id            String    @id @default(cuid())
  dosyaAdi      String
  kaynakTipi    String // csv | xlsx
  yukleyenId    String?
  /// eslesme | dogrulama_bekliyor | onaylandi | reddedildi | hata
  durum         String    @default("eslesme")
  /// kullanıcının kurduğu kolon eşlemesi: { "asset_tag": "etiket", … }
  eslemeJson    String?
  /// ham başlık satırı — eşleme ekranı bunu gösterir
  basliklarJson String?
  okunan        Int       @default(0)
  gecerli       Int       @default(0)
  hatali        Int       @default(0)
  yinelenen     Int       @default(0)
  eklenen       Int       @default(0)
  guncellenen   Int       @default(0)
  /// satır önizlemesi, hata listesi, yinelenen eşleşmeleri
  raporJson     String?
  onaylayanId   String?
  onayZamani    DateTime?
  olusturuldu   DateTime  @default(now())

  yukleyen  Kullanici? @relation("AktarimYukleyen", fields: [yukleyenId], references: [id])
  onaylayan Kullanici? @relation("AktarimOnaylayan", fields: [onaylayanId], references: [id])
}

/// Adlandırılmış iş kilidi — aynı işin iki süreçte birden koşmasını engeller.
///
/// Eskiden çakışma önleme "önce `calisiyor` satırı var mı diye bak, yoksa
/// oluştur" biçimindeydi. Bu bir KONTROL-SONRA-KULLAN yarışıdır: iki süreç
/// (ya da tek süreçte iki eşzamanlı tik) aynı anda "yok" görüp ikisi de
/// koşuyu açabilir. Tek örnekli geliştirmede görünmez, iki örnekli
/// dağıtımda her motor iki kez koşar ve bulguları çoğaltır.
///
/// Burada kilit TEK bir atomik ifadeyle alınır: ya süresi dolmuş satırı
/// güncelleyerek devralırsın, ya birincil anahtar çakışmasına çarparsın.
/// İkisi de kaybetmeyi güvenli kılar: kaybeden koşmaz.
///
/// `gecerlilik` bir KİRA'dır, sonsuz kilit değil: süreç ölürse kilit
/// kendiliğinden serbest kalır. Süreci ölen bir işin kilidini elle
/// temizlemek gerekseydi, ilk çökmede tüm otomasyon kalıcı olarak dururdu.
model IsKilidi {
  /// Kilit adı: motor için `motor:<ad>`, connector için `connector:<id>`.
  ad         String   @id
  /// Kilidi tutan çalışma örneğinin kimliği (süreç başına üretilir).
  sahip      String
  alindi     DateTime @default(now())
  /// Kira bitişi. Bu anı geçmiş kilit devralınabilir.
  gecerlilik DateTime

  @@index([gecerlilik])
}
